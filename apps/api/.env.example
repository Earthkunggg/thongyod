# Copy to .env and enter your app-role password there. Never commit .env.
NODE_ENV=development
APP_ENV=local
# Off by default. Dev login requires all three local development flags.
ENABLE_DEV_LOGIN=false
# Production logout origin (exact HTTPS origin, no trailing slash):
# APP_ORIGIN=https://your-app.example
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=thongyod_dev
PGUSER=thongyod_app
# Required: enter the app-role password in .env. Quote values containing # or spaces.
PGPASSWORD=
TEST_PGDATABASE=thongyod_test
# Optional fixed ISO instant for reproducible dates; otherwise uses the current day.
# SEED_ANCHOR=2026-11-03T05:00:00.000Z
