# Copy to .env.local (never commit .env.local). Development only.
# Which API areas use the mock (src/mocks) instead of the real backend (apps/api via /api proxy):
#   all               mock everything (default)
#   off               real backend for everything
#   friends,meetups   mock only these areas
# Areas: auth, me, profiles, friends, meetups, home
VITE_API_MOCKS=all
